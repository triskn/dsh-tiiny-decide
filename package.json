{
  "name": "dsh-tiiny-decide",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Build reusable System One workflows in DeepSeek Harness and run them on Tiiny Pocket.",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "exports": {
    ".": "./dsh-host.js",
    "./client": "./dsh-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dsh-icon.svg"
  },
  "files": [
    "dsh-host.js",
    "dsh-client.js",
    "dsh-icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "lib",
    "examples"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "homepage": "https://github.com/triskn/dsh-tiiny-decide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triskn/dsh-tiiny-decide.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tiiny-pocket",
    "system-one"
  ]
}
