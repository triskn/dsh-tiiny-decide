{
  "name": "tiiny-decide",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A local workbench for reusable System One decisions, standalone or in DeepSeek Harness",
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.3 <0.3.0" },
  "exports": {
    ".": "./dsh-host.js",
    "./client": "./dsh-client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./dsh-icon.svg"
  },
  "files": ["dsh-host.js", "dsh-client.js", "dsh-icon.svg", "cordis.patch.yml", "locale/*.json", "server.mjs", "lib", "public", "examples", "test", ".env.example", ".gitignore"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale"]
    }
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "demo:upstream": "node examples/demo-upstream.mjs"
  }
}
